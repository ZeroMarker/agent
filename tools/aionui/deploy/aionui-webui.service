[Unit]
Description=AionUi WebUI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.local/share/aionui/source
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.local/share/pi-node/node-v22.23.2-linux-arm64/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=AIONUI_HOST=127.0.0.1
Environment=AIONUI_DATA_DIR=/home/ubuntu/.aionui-web
Environment=AIONUI_BACKEND_BIN=/home/ubuntu/.local/share/aionui/runtime/aioncore
Environment=AIONUI_STATIC_DIR=/home/ubuntu/.local/share/aionui/source/out/renderer
ExecStart=/usr/local/bin/node /home/ubuntu/.local/share/aionui/source/node_modules/tsx/dist/cli.mjs scripts/webui.ts --no-build --no-open --port 25808
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StandardOutput=append:/home/ubuntu/.local/state/aionui/service.log
StandardError=append:/home/ubuntu/.local/state/aionui/service.log

[Install]
WantedBy=multi-user.target
