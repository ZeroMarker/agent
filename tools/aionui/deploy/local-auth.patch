diff --git a/tests/unit/renderer/authCurrentUser.dom.test.tsx b/tests/unit/renderer/authCurrentUser.dom.test.tsx
--- /dev/null
+++ b/tests/unit/renderer/authCurrentUser.dom.test.tsx
@@ -0,0 +1,67 @@
+import React from 'react';
+import { cleanup, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('@/common/adapter/sessionRefresh', () => ({ refreshSession: vi.fn(async () => false) }));
+vi.mock('@/renderer/pages/conversation/Preview/context/previewScope', () => ({
+  PREVIEW_SCOPE_KEY_PREFIX: 'preview-ui:',
+}));
+
+describe('WebUI current user', () => {
+  beforeEach(() => {
+    vi.resetModules();
+    Reflect.deleteProperty(window, 'electronAPI');
+  });
+
+  afterEach(() => {
+    cleanup();
+    vi.unstubAllGlobals();
+  });
+
+  async function renderAuth() {
+    const { AuthProvider, useAuth } = await import('@renderer/hooks/context/AuthContext');
+    function Status() {
+      const { status, user } = useAuth();
+      return <div>{`${status}:${user?.id ?? ''}`}</div>;
+    }
+    render(
+      <AuthProvider>
+        <Status />
+      </AuthProvider>
+    );
+  }
+
+  it('opens the existing local identity without an application login cookie', async () => {
+    const fetchMock = vi.fn(
+      async () =>
+        new Response(
+          JSON.stringify({ success: true, data: { id: 'system_default_user', username: 'system_default_user' } })
+        )
+    );
+    vi.stubGlobal('fetch', fetchMock);
+    await renderAuth();
+    await screen.findByText('authenticated:system_default_user');
+    expect(fetchMock.mock.calls[0]).toEqual([
+      '/api/system/current-user',
+      expect.objectContaining({ credentials: 'include' }),
+    ]);
+  });
+
+  it('keeps the login requirement when the backend rejects the session', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => new Response('{}', { status: 401 }))
+    );
+    await renderAuth();
+    await screen.findByText('unauthenticated:');
+  });
+
+  it('does not accept an unsuccessful current-user response', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => new Response(JSON.stringify({ success: false })))
+    );
+    await renderAuth();
+    await waitFor(() => expect(screen.getByText('unauthenticated:')).toBeTruthy());
+  });
+});
