[Unit]
Description=CloudCLI (Claude Code UI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agent
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=SERVER_PORT=3001
Environment=DATABASE_PATH=/home/ubuntu/.local/state/cloudcli/auth.db
Environment=CLAUDE_CLI_PATH=/home/ubuntu/.local/bin/claude
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.local/share/pi-node/node-v22.23.2-linux-arm64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node /home/ubuntu/.local/share/cloudcli/node_modules/@cloudcli-ai/cloudcli/dist-server/server/modules/cli/cli.js start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
