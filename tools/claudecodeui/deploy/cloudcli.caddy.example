cli.20070809.xyz {
	encode zstd gzip

	# 首次创建账号必须先通过 Caddy 登录。
	handle /api/auth/register {
		basic_auth {
			admin <PASSWORD_HASH>
		}
		reverse_proxy 127.0.0.1:3001 {
			header_up -Authorization
		}
	}

	# API / WebSocket 使用 CloudCLI 自身 JWT；不能叠加 Basic Auth。
	@app path /api/* /ws /shell /desktop-notifications /plugin-ws/*
	handle @app {
		@basic header Authorization Basic*
		request_header @basic -Authorization
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		basic_auth {
			admin <PASSWORD_HASH>
		}
		reverse_proxy 127.0.0.1:3001 {
			header_up -Authorization
		}
	}
}
