[Unit]
Description=Chromium desktop with Xvfb and noVNC
Documentation=file:/usr/local/share/doc/browser-desktop/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=browser-desktop
Group=browser-desktop
Environment=HOME=/home/browser-desktop
Environment=XDG_RUNTIME_DIR=/run/browser-desktop
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
Environment=CHROMIUM_BIN=/opt/browser-desktop/bin/chromium
Environment=BROWSER_PROFILE_DIR=/home/browser-desktop/.config/chromium
Environment=BROWSER_RUNTIME_DIR=/run/browser-desktop
Environment=BROWSER_LOG_DIR=/var/log/browser-desktop
Environment=NOVNC_LISTEN_ADDRESS=127.0.0.1
Environment=CDP_LISTEN_ADDRESS=127.0.0.1
Environment=ENABLE_CHROME_SANDBOX=false
EnvironmentFile=-/etc/default/browser-desktop
ExecStart=/usr/local/libexec/browser-desktop/start-browser.sh
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077

RuntimeDirectory=browser-desktop
RuntimeDirectoryMode=0700
LogsDirectory=browser-desktop
LogsDirectoryMode=0700
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
